{
  "expo": {
    "name": "New School",
    "slug": "newschool",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "newschool",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.newschool.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Trouver des événements près de vous",
        "NSLocationAlwaysUsageDescription": "Trouver des événements près de vous",
        "NSCameraUsageDescription": "Prendre des photos pour votre profil et événements",
        "NSPhotoLibraryUsageDescription": "Sélectionner des photos pour votre profil et événements"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.newschool.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Permettre à New School d'utiliser votre position pour trouver des événements."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Permettre à New School d'accéder à vos photos."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
